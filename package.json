{
    "name": "api-vinted",
    "version": "1.0.0",
    "description": "RESTful backend API for a Vinted-inspired second-hand clothing marketplace.",
    "main": "index.js",
    "scripts": {
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage --coverageReporters=json-summary --coverageReporters=text",
        "make-badges": "istanbul-badges-readme --coverageDir=coverage",
        "dev": "nodemon index.js",
        "start": "node index.js",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "security": "npm audit"
    },
    "keywords": [
        "express",
        "mongodb",
        "rest-api",
        "vinted"
    ],
    "author": "Dan Zerbib",
    "license": "MIT",
    "type": "commonjs",
    "dependencies": {
        "bcryptjs": "^3.0.3",
        "cloudinary": "^2.11.0",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "express-fileupload": "^1.5.2",
        "express-rate-limit": "^8.7.0",
        "helmet": "^8.3.0",
        "joi": "^18.2.9",
        "jsonwebtoken": "^9.0.3",
        "mongoose": "^9.10.0",
        "resend": "^6.28.1",
        "swagger-jsdoc": "^6.3.0",
        "swagger-ui-express": "^5.0.1",
        "uid2": "^1.0.0"
    },
    "overrides": {
        "mongodb": "7.0.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.10.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.12.0",
        "istanbul-badges-readme": "^1.9.0",
        "jest": "^30.5.1",
        "mongodb-memory-server": "^11.2.0",
        "nodemon": "^3.1.14",
        "prettier": "^3.9.8",
        "supertest": "^7.2.2"
    }
}
